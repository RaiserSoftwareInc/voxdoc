Windows Registry Editor Version 5.00

; Register .vox file extension as HTML content type
[HKEY_CLASSES_ROOT\.vox]
@="VoxDocument"
"Content Type"="text/html"
"PerceivedType"="text"

[HKEY_CLASSES_ROOT\VoxDocument]
@="Vox Document"

[HKEY_CLASSES_ROOT\VoxDocument\DefaultIcon]
@="shell32.dll,1"

; Open with default browser
[HKEY_CLASSES_ROOT\VoxDocument\shell]
@="open"

[HKEY_CLASSES_ROOT\VoxDocument\shell\open]
@="Open in Browser"

[HKEY_CLASSES_ROOT\VoxDocument\shell\open\command]
@="\"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\" \"%1\""
