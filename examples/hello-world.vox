  "blocks": [
    {
      "id": "heading-welcome",
      "type": "heading",
      "level": 1,
      "content": "Welcome to {{format_name}}"
    },
    {
      "id": "intro-paragraph",
      "type": "paragraph",
      "content": "**{{format_name}}** is a structured document format designed to replace static PDFs with accessible, interactive, and machine-readable documents. Every {{format_name}} document is a JSON file that can be validated, compiled to HTML, and reviewed collaboratively."
    },
    {
      "id": "tip-getting-started",
      "type": "callout",
      "variant": "tip",
      "title": "Getting Started",
      "content": "You can create your first {{format_name}} document in under a minute using the CLI. Just run `vox init` and start adding blocks."
    },
    {
      "id": "install-code",
      "type": "code",
      "language": "bash",
      "content": "# Install the Vox CLI globally\nnpm install -g @vox/cli\n\n# Create a new document\nvox init my-document\n\n# Add some content\nvox add heading --content \"Hello World\"\nvox add paragraph --content \"This is my first Vox document.\"\n\n# Validate and compile\nvox validate my-document.vox\nvox compile my-document.vox --output my-document.html",
      "filename": "terminal"
    },
    {
      "id": "heading-why-vox",
      "type": "heading",
      "level": 2,
      "content": "Why {{format_name}}?"
    },
    {
      "id": "why-vox-paragraph",
      "type": "paragraph",
      "content": "Traditional PDFs are opaque binaries that resist search indexing, accessibility tools, and programmatic manipulation. {{format_name}} solves these problems by storing documents as structured JSON with semantic block types, built-in accessibility metadata, and a compilation pipeline that produces standards-compliant HTML."
    },
    {
      "id": "comparison-table",
      "type": "table",
      "headers": ["Feature", "PDF", "{{format_name}}"],
      "rows": [
        ["Machine-readable", "Limited (requires parsing)", "Yes (native JSON)"],
        ["Accessibility", "Varies widely", "Built-in and enforced"],
        ["Version control", "Binary diffs only", "Clean JSON diffs"],
        ["Interactive content", "Limited forms", "Tabs, accordions, diagrams"],
        ["Collaboration", "Annotations only", "Block-level review and comments"],
        ["Responsive layout", "Fixed page size", "Adapts to any screen"]
      ],
      "caption": "PDF vs Vox comparison",
      "summary": "A feature-by-feature comparison of traditional PDF documents and Vox documents, covering machine readability, accessibility, version control, interactivity, collaboration, and responsive layout."
    },
    {
      "id": "heading-workflow",
      "type": "heading",
      "level": 2,
      "content": "The {{format_name}} Workflow"
    },
    {
      "id": "workflow-paragraph",
      "type": "paragraph",
      "content": "The diagram below shows how a {{format_name}} document moves from creation to publication. Each step in the pipeline is designed to catch errors early and ensure quality."
    },
    {
      "id": "workflow-diagram",
      "type": "diagram",
      "syntax": "mermaid",
      "content": "graph LR\n    A[Init] --> B[Populate]\n    B --> C[Validate]\n    C --> D[Review]\n    D --> E[Compile]\n    E --> F[Publish]",
      "description": "A linear workflow diagram showing the six stages of a Vox document lifecycle: Init creates the document, Populate adds content blocks, Validate checks structure and accessibility, Review enables collaborative feedback, Compile generates HTML output, and Publish delivers the final document."
    },
    {
      "id": "heading-faq",
      "type": "heading",
      "level": 2,
      "content": "Frequently Asked Questions"
    },
    {
      "id": "faq-what-is-block",
      "type": "accordion",
      "title": "What is a block?",
      "default_open": true,
      "blocks": [
        {
          "id": "faq-block-answer",
          "type": "paragraph",
          "content": "A block is the fundamental unit of content in a {{format_name}} document. Each block has a type (such as heading, paragraph, code, or table), a unique identifier, and type-specific properties. Blocks can be nested inside container blocks like accordions, tabs, and steps."
        }
      ]
    },
    {
      "id": "faq-accessibility",
      "type": "accordion",
      "title": "How does Vox handle accessibility?",
      "blocks": [
        {
          "id": "faq-a11y-answer",
          "type": "paragraph",
          "content": "Accessibility is a first-class concern in {{format_name}}. The compiler enforces that all images have alt text, all diagrams have descriptions, all tables have summaries, and all math blocks have spoken text. The compiled HTML includes ARIA attributes, skip navigation, semantic elements, and responsive CSS that adapts to any viewport or assistive technology."
        }
      ]
    },
    {
      "id": "faq-format",
      "type": "accordion",
      "title": "Can I convert existing PDFs to Vox?",
      "blocks": [
        {
          "id": "faq-format-answer",
          "type": "paragraph",
          "content": "Yes. The {{format_name}} MCP server can assist with converting existing documents by extracting structure, generating block content, and flagging areas that need human review. The conversion process preserves as much semantic meaning as possible and marks low-confidence sections for verification."
        }
      ]
    },
    {
      "id": "var-format-name",
      "type": "variable_def",
      "key": "format_name",
      "value": "Vox"
    }
  ],
